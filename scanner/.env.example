# --- Postgres ---
POSTGRES_USER=tally
POSTGRES_PASSWORD=tally
POSTGRES_DB=tally_scanner
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tally:tally@localhost:5432/tally_scanner
# Browser GUI (Adminer): http://localhost:8081
ADMINER_PORT=8081

# --- Timezone (used by optional bundled-n8n profile) ---
TZ=America/Vancouver
# Bundled n8n is OFF by default — use your existing n8n app.
# Only needed if you run: docker compose --profile bundled-n8n up -d
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/

# --- Scanner worker ---
SCANNER_PORT=8000
# Dry-run skips OpenAI calls (filter/score stubs)
SCANNER_DRY_RUN=false

# --- OpenAI (triage + scorer — only LLM provider) ---
OPENAI_API_KEY=
OPENAI_FILTER_MODEL=gpt-4o-mini
OPENAI_SCORE_MODEL=gpt-4o

# --- Notion (optional legacy sink) ---
# Create an integration at https://www.notion.so/my-integrations
# Share the scanner DB with that integration.
NOTION_TOKEN=
# Parent page for creating the scanner database (from handoff):
NOTION_PARENT_PAGE_ID=37272d09-0a44-80ec-a852-000b049519b1
# Set after first run creates the DB (or create manually and paste id):
NOTION_DATABASE_ID=

# --- SearXNG (docker compose --profile searxng up) ---
SEARXNG_PORT=8080
SEARXNG_URL=http://localhost:8080

# --- Indeed (search-first) ---
# Direct HTTP to indeed.com is Cloudflare-blocked.
# Set Firecrawl key for live stealth scrapes (optional; fixture works offline).
# FIRECRAWL_API_KEY=
# LinkedIn crawl fetch seam (Firecrawl scrape URL = proxied HTML)
# TRIGGER_SECRET_KEY=tr_dev_...
# TRIGGER_PROJECT_REF=proj_...

# --- Batch email alerts (LinkedIn job extract) ---
# BATCH_NOTIFY_EMAIL=you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password-here
# SMTP_FROM=you@gmail.com
# BATCH_NOTIFY_EVERY=25
